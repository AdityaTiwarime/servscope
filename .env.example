# Copy to .env and change both secrets. .env is git-ignored; never commit real secrets.
SERVSCOPE_INGEST_TOKEN=change-me-to-a-long-random-string
SERVSCOPE_DB_PASSWORD=change-me-too
# demo turns on the API docs page and allows failure scenarios; production refuses both.
SERVSCOPE_ENV=demo

# Admin: changing alert rules and settings, starting scenarios. Empty = admin is off.
# Make one with:  openssl rand -hex 24
SERVSCOPE_ADMIN_TOKEN=

# Failure scenarios (Demo scenarios screen). Off by default. To turn them on, set this to
# true AND set both tokens (the fault token is shared with the demo shop's fault switches).
SERVSCOPE_FAILURE_INJECTION=false
SERVSCOPE_FAULT_TOKEN=

# Checkouts per second from the built-in traffic generator.
TRAFFIC_RPS=2
